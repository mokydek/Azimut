# Frontend variables (bundled into the browser build, safe to expose).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ANTHROPIC_API_KEY is a SERVER SIDE secret used only by the Vercel function
# api/analyze.ts. Never give it the VITE_ prefix: any VITE_ variable is bundled
# into the browser build and would leak the key. In production it is set in the
# Vercel project environment variables, not in this file.
# ANTHROPIC_API_KEY=
